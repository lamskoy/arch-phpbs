+/*
+ * ERR_NUM_ERRORS was removed in OpenSSL 4.0. It is only used below as the
+ * size of the error ring buffer, so fall back to a fixed size.
+ */
+#ifndef ERR_NUM_ERRORS
+# define ERR_NUM_ERRORS 137
+#endif
+
+/*
+ * Direct member access to the ASN1_STRING family was removed when the
+ * structs became opaque in OpenSSL 4.0. Use the accessors on OpenSSL >= 1.1.0.
+ */
+#if OPENSSL_VERSION_NUMBER >= 0x10100000L
+# define PHP_OPENSSL_ASN1_STRING_DATA(x)   (ASN1_STRING_get0_data(x))
+# define PHP_OPENSSL_ASN1_STRING_LENGTH(x) (ASN1_STRING_length(x))
+#else
+# define PHP_OPENSSL_ASN1_STRING_DATA(x)   ((x)->data)
+# define PHP_OPENSSL_ASN1_STRING_LENGTH(x) ((x)->length)
+#endif
+
+
